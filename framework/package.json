{
  "name": "luckycat-agent-framework",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "招财猫 agent 框架：DeepSeek Harness 之上的树外插件集合（不改内核，增删插件）",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "workbench:setup": "node scripts/setup-workbench.mjs",
    "workbench:start": "node scripts/start-workbench.mjs",
    "test:workbench": "node scripts/check-workbench.mjs",
    "test:reminders": "node --test bridge/bank-reminders.test.mjs bridge/bank-reminder-agent.test.mjs",
    "bootstrap:customer": "node scripts/bootstrap-customer.mjs",
    "start:im": "node scripts/start-im.mjs",
    "start:im:local": "node scripts/start-im-local.mjs",
    "stop:im:local": "node scripts/stop-im-local.mjs",
    "test:im": "node --test bridge/im.test.mjs bridge/im-local.test.mjs bridge/im-query.test.mjs",
    "test:im:customer-qr": "node --test bridge/im-customer-qr.test.mjs",
    "test:im:browser": "node scripts/check-im-browser.mjs",
    "start:staff": "node scripts/bootstrap-staff.mjs && node bridge/staff-server.mjs",
    "start:ops": "node scripts/bootstrap-staff.mjs && node bridge/ops-server.mjs",
    "test:ops-agent": "node --test bridge/clef-reviewer.test.mjs bridge/ops-gate.test.mjs",
    "test:ops-agent:e2e": "node ../tools/check-ops-agent.mjs --browser",
    "test:ops-agent:live": "node ../tools/check-ops-agent-live.mjs",
    "test:staff": "node --test bridge/staff-agent.test.mjs",
    "test:staff:e2e": "node ../tools/check-staff-agent.mjs --browser",
    "test:staff:live": "node ../tools/check-staff-agent-live.mjs",
    "dump-config": "bash scripts/dsh-profile.sh dump-config",
    "verify": "bash scripts/verify.sh",
    "check:dsh": "node scripts/check-dsh-versions.mjs",
    "knowledge": "node scripts/build-knowledge.mjs",
    "test:knowledge": "node --test packages/rag/tests/*.test.mjs",
    "skills": "node scripts/check-skills.mjs",
    "test:skills": "node --test packages/skills/tests/*.test.mjs",
    "test:skills:e2e": "node ../tools/check-agent-skills.mjs"
  },
  "dependencies": {
    "@dely0/dsh-personal-workbench": "1.17.0",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@xmanrui/dsh-im": "5.1.0",
    "js-yaml": "^4.3.2",
    "node-pty": "^1.2.0-beta.15",
    "ws": "^8.21.3"
  },
  "overrides": {
    "@dely0/dsh-personal-workbench": {
      "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
      "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
      "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
      "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
      "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^22.20.3",
    "typescript": "^6.0.3"
  }
}

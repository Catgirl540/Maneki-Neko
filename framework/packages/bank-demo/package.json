{
  "name": "@luckycat/dsh-bank-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "银行示例消费者：占位业务工具 + 敏感操作规则表（不是通用框架层）",
  "main": "lib/index.js",

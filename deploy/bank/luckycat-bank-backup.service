[Unit]
Description=Checked online backup of Luckycat SQLite database
After=luckycat-bank.service
OnFailure=luckycat-bank-alert@%n.service

[Service]
Type=oneshot
User=bank
Group=bank
WorkingDirectory=/srv/maneki-bank/current
ExecStart=/usr/bin/python3 -B deploy/bank/backup.py
TimeoutStartSec=35min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/luckycat-bank /var/backups/luckycat-bank

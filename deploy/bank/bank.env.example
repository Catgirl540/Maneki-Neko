# Copy to /etc/luckycat-bank/bank.env; keep actual credentials out of source control.
# Permissions: root:root 0600. systemd reads EnvironmentFile before switching User.
NODE_ENV=production
BANK_INTEGRATION_MODE=sandbox
BANK_HOST=127.0.0.1
BANK_PORT=8080
BANK_DB_FILE=/var/lib/luckycat-bank/bank.sqlite
BANK_BACKUP_DIR=/var/backups/luckycat-bank
# Generate a fresh 32-byte base64 key into the protected deployment file.
# This placeholder deliberately fails production key validation.
BANK_DATA_KEY=REPLACE_WITH_32_BYTE_BASE64_SECRET
# Configure these with distinct, non-default operator secrets before deployment.
BANK_CSR_PASSWORD=REPLACE_WITH_UNIQUE_CSR_SECRET
BANK_SUPERVISOR_PASSWORD=REPLACE_WITH_UNIQUE_SUPERVISOR_SECRET
BANK_OPS_PASSWORD=REPLACE_WITH_UNIQUE_OPERATOR_SECRET
BANK_CLIENT_HEALTH_URL=http://127.0.0.1/bank/
BANK_STAFF_HEALTH_URL=http://127.0.0.1/bank/staff/
# Confirm the existing AI gateway endpoint on the actual host before enabling.
# BANK_AGENT_HEALTH_URL=http://127.0.0.1:8788/agent-api/health

[Unit]
Description=Luckycat isolated PUBLIC DEMO bank (sandbox, no real SMS or money)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=bank
Group=bank
WorkingDirectory=/srv/maneki-bank/demo-20261017
EnvironmentFile=/etc/luckycat-bank-demo/bank.env
ExecStart=/opt/maneki-node24/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/luckycat-bank-demo

[Install]
WantedBy=multi-user.target

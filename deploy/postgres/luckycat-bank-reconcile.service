[Unit]
Description=Read-only Luckycat PostgreSQL ledger reconciliation
After=postgresql.service
OnFailure=luckycat-bank-alert@%n.service

[Service]
Type=oneshot
User=bank
Group=bank
WorkingDirectory=/srv/maneki-bank/current
EnvironmentFile=/etc/luckycat-bank/bank.env
EnvironmentFile=/etc/luckycat-bank/pg-app.env
Environment=BANK_AUTO_MIGRATE=false
ExecStart=/opt/maneki-node24/bin/node server/reconcile.mjs
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

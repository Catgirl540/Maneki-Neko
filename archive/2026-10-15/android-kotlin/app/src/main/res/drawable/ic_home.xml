<?xml version="1.0" encoding="utf-8"?>
<!--
  房子：三角屋顶 + 方屋身。
  形状是从改造前那份 Canvas 代码**逐点平移**过来的（原来的坐标是 `w*0.10f` 这类比例，
  乘 24 就是这里的绝对值），所以视觉与之后画的一模一样。
  线宽 2.64：原来写的是 `size * 0.11f`，在 22dp 下是 2.42dp；
  `2.64 * 22 / 24 = 2.42`，换算过来粗细不变。
  fillColor 必须透明，否则 `ColorFilter.tint` 会把整个图形填成实心色块。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M2.4,11.04 L12,2.88 L21.6,11.04 M4.8,10.56 L4.8,20.64 L19.2,20.64 L19.2,10.56"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.64"
        android:strokeLineCap="round" />
</vector>

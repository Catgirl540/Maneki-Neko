# 依赖与构建产物：不进仓库（前者体积大且可重装，后者每次构建都变）
node_modules/
dist/

# 本机 npm 缓存（之前为了让 npm 在只读缓存环境下能跑，指到了仓库里）
.npm-cache/

# 上游 codex-cli 源码快照（只读参考，用来实现本项目 AI Agent 入口）
# 来源：github.com/openai/codex 的 GitHub tarball，commit a113f3e0（2026-09-15）
# 解压后约 99M / 7925 个文件，第三方源码，不进仓库
reference/

# 从快照派生出来的 agent 改造仓库（独立 git 仓库，不进银行仓库）
agent/

# 本机 Rust 工具链与 cargo 缓存（沙箱下 ~/.cargo 不可写，只能落在工作目录里）
.toolchain/

# agent 框架（DeepSeek Harness 之上的树外插件集合，独立 git 仓库，不进银行仓库）
framework/

# 编辑器 / 系统
.DS_Store
*.swp
.idea/
.vscode/

# 本地环境覆盖（.env.development / .env.production 是刻意提交的，见 README §3）
.env.local
.env.*.local
